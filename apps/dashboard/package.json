{
  "name": "bench-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop dashboard for the ESP32 wifi-lab-w2 firmware: a Node server that talks to the board and a React app.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/src/index.ts",
    "remote": "vite build && NODE_ENV=production node --env-file-if-exists=.env server/src/index.ts",
    "tunnel:cloudflare": "cloudflared tunnel --url http://localhost:8787",
    "tunnel:ngrok": "ngrok http 8787",
    "typecheck": "tsc -p server && tsc -p web",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
