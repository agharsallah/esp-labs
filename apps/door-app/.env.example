# Where the board is: its mDNS name, or the IP address the board prints (serial: status).
BENCH_URL=http://bench.local
# The admin token: serial command `token` on the board. Every change to the card list needs it.
# Vite's dev server adds it to the requests it forwards, so it never reaches the browser.
# Keep this file out of git (it is in .gitignore) and the token out of chats.
BENCH_TOKEN=
