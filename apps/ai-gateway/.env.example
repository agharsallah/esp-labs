# Copy to .env (git-ignored) and fill in.

# What the board must send (serial on the board: ai key <this>). LiteLLM wants it to start with sk-.
# Make one with: echo "sk-bench-$(openssl rand -hex 16)"
LITELLM_MASTER_KEY=

# Provider keys: only the ones you use. They stay on this machine, never on the board.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
