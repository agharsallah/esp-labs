# Where the board is: its mDNS name, or the IP address the board prints (serial: status).
BENCH_URL=http://bench.local
# The admin token: serial command `token` on the board (the same token as W2 and R7).
# Moving a friend onto a card needs it. Vite's dev server adds it to the requests it forwards,
# so it never reaches the browser. Keep this file out of git and the token out of chats.
BENCH_TOKEN=
