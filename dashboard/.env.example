# Copy to .env and fill in. .env is git-ignored.

# How the server reaches the board:
#   lan    the server dials the board at ESP_URL (your Wi-Fi, firmware wifi-lab-w2)
#   relay  the board dials in to this server's /device from anywhere (firmware wifi-lab-w2-remote).
#          The server needs a public https address: your Mac + a tunnel (pnpm remote, then
#          pnpm tunnel:cloudflare or pnpm tunnel:ngrok), or a hosted server (VPS, Fly.io, Render...)
ESP_MODE=lan

# LAN mode: where the board answers. bench.local works on macOS and most Linux; use the IP from the
# board's status view if your network blocks mDNS. On the board's set-up network: http://192.168.4.1
ESP_URL=http://bench.local

# Admin token for reboot / forget Wi-Fi / firmware update. Serial command on the board: token
# Leave empty to run the dashboard without admin actions. Relay mode needs it: the board signs in
# to /device with it.
ESP_TOKEN=

# Sign-in key for the dashboard itself. Needed in relay mode (the tunnel makes it public),
# optional otherwise. At least 16 characters, e.g. the output of: openssl rand -hex 16
DASHBOARD_KEY=

# Port the dashboard server listens on (the React dev server proxies /api and /ws to it).
# On a hosted server: HOST=0.0.0.0, and PORT is usually set by the platform.
PORT=8787
HOST=127.0.0.1
# Which proxy in front of the server may report HTTPS: the local tunnel by default. Behind a
# hosting platform's proxy: true, or the proxy's IPs/CIDRs, comma-separated.
TRUST_PROXY=127.0.0.1
LOG_LEVEL=info
