{
  "name": "bench-door-app",
  "version": "0.1.0",
  "private": true,
  "description": "R7 card manager: a small React app for the rfid-lab-r7 bench door. Vite's dev server serves it and forwards /api and /ws to the board, adding the admin token from .env.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
